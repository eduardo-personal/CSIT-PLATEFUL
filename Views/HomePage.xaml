<Page
    x:Class="Plateful.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Plateful.Models"
    xmlns:viewmodels="using:Plateful.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:HomeViewModel}"
    Background="{ThemeResource SystemAltHighColor}"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea" Margin="{StaticResource NavigationViewPageContentMargin}">

        <!--  Login Grid  -->
        <Grid Name="LoginGrid" Visibility="Visible">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical"
                Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Login" />
                <TextBox Name="UsernameTextBox" PlaceholderText="Username" />
                <PasswordBox Name="PasswordTextBox" PlaceholderText="Password" />
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CreateAccount_Click"
                    Content="Don't have an account? Sign up" />
                <Button
                    HorizontalAlignment="Right"
                    Click="LoginIn_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <Button.Content>
                        <TextBlock Text="Login" />
                    </Button.Content>
                </Button>
                <TextBlock Name="LoginStatusTextBlock" />
            </StackPanel>
        </Grid>
        <Grid x:Name="MainPage" Visibility="Collapsed">
            <!--  floating add button  -->
            <Button
                Margin="0,0,0,20"
                Padding="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Canvas.ZIndex="1"
                Click="OnMealPage_Click"
                CornerRadius="20"
                Style="{ThemeResource AccentButtonStyle}">

                <Button.Content>
                    <StackPanel
                        Margin="5,0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <FontIcon Glyph="&#xE710;" />
                        <TextBlock Text="Add" />
                    </StackPanel>
                </Button.Content>
            </Button>
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  header  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="Plateful" />

                    <Button
                        Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Daily Digest Options">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Settings">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Logout">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE711;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                            </MenuFlyout>


                        </Button.Flyout>
                        <Button.Content>
                            <Grid
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid
                                    Grid.Column="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Welcome back," />
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{Binding CurrentUser.Username, Mode=OneWay}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Right"
                                        Text="{Binding CurrentUser.Email}" />
                                </Grid>


                                <Border
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="40">
                                    <Image Source="/Assets/wave.jpg" Stretch="UniformToFill" />

                                </Border>

                            </Grid>
                        </Button.Content>

                    </Button>

                </Grid>


                <Grid Grid.Row="1" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Daily Digest" />

                        <Button
                            Grid.Column="1"
                            Padding="8"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnDigestPage_Click">
                            <Button.Content>
                                <FontIcon FontSize="13" Glyph="&#xE713;" />
                            </Button.Content>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>



                        <Button
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Water Intake" />
                                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="2L / 5L" />
                                <ProgressBar
                                    Height="10"
                                    Foreground="Blue"
                                    Value="40" />
                            </StackPanel>
                        </Button>

                        <!--  Protein Intake  -->
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Protein Intake" />
                                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="40g / 100g" />
                                <ProgressBar
                                    Height="10"
                                    Foreground="DarkGreen"
                                    Value="40" />
                            </StackPanel>
                        </Button>

                        <!--  Carbs Intake (or Fats Intake)  -->
                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Carbs Intake" />
                                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="150g / 300g" />
                                <ProgressBar
                                    Height="10"
                                    Foreground="Orange"
                                    Value="50" />
                            </StackPanel>
                        </Button>
                    </Grid>

                </Grid>

                <!--  header content  -->
                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <GridView ItemsSource="{Binding DefaultPlates}" SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:MealModel">
                                <Button
                                    Width="160"
                                    Height="150"
                                    Padding="10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                    <Button.Content>
                                        <Border Padding="10" CornerRadius="8">
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                Orientation="Vertical"
                                                Spacing="5">

                                                <!--  Meal Icon  -->
                                                <Image
                                                    Width="60"
                                                    Height="60"
                                                    Source="/Assets/MealIcon/plate.png"
                                                    Stretch="UniformToFill" />

                                                <!--  Meal Name  -->
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}"
                                                    TextAlignment="Center"
                                                    TextTrimming="CharacterEllipsis" />

                                                <!--  Meal Cost  -->
                                                <TextBlock
                                                    FontSize="14"
                                                    Foreground="Gray"
                                                    Text="$2"
                                                    TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button.Content>
                                </Button>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <StackPanel
                    Grid.Row="3"
                    Orientation="Vertical"
                    Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="My Meals" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button Background="Transparent" BorderThickness="0">
                                <Button.Content>
                                    <FontIcon FontSize="15" Glyph="&#xE70F;" />

                                </Button.Content>
                            </Button>
                            <Button Background="Transparent" BorderThickness="0">
                                <Button.Content>
                                    <FontIcon FontSize="15" Glyph="&#xE712;" />
                                </Button.Content>
                            </Button>

                        </StackPanel>
                    </Grid>
                    <GridView ItemsSource="{Binding DefaultPlates}" SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:MealModel">
                                <Button
                                    Width="160"
                                    Height="150"
                                    Padding="10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                    <Button.Content>
                                        <Border Padding="10" CornerRadius="8">
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                Orientation="Vertical"
                                                Spacing="5">

                                                <!--  Meal Icon  -->
                                                <Image
                                                    Width="60"
                                                    Height="60"
                                                    Source="/Assets/MealIcon/plate.png"
                                                    Stretch="UniformToFill" />

                                                <!--  Meal Name  -->
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}"
                                                    TextAlignment="Center"
                                                    TextTrimming="CharacterEllipsis" />

                                                <!--  Meal Cost  -->
                                                <TextBlock
                                                    FontSize="14"
                                                    Foreground="Gray"
                                                    Text="$2"
                                                    TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button.Content>
                                </Button>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
