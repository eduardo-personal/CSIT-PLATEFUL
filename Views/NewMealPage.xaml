<Page
    x:Class="Plateful.Views.NewMealPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource SystemAltHighColor}"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea" Margin="{StaticResource NavigationViewPageContentMargin}">
        <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <!--  Left Column (Meal Info)  -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="New Meal" />
                    <InfoBar
                        Title="New Meal"
                        Margin="0,0,0,20"
                        IsOpen="True"
                        Message="Log your meal details, track its nutrition, and save for later."
                        Severity="Informational" />

                    <!--  Meal Category  -->
                    <ComboBox PlaceholderText="Select Meal Type">
                        <ComboBoxItem Content="Breakfast" />
                        <ComboBoxItem Content="Lunch" />
                        <ComboBoxItem Content="Dinner" />
                        <ComboBoxItem Content="Snack" />
                    </ComboBox>

                    <!--  Meal Name  -->
                    <TextBox x:Name="MealNameTextBox" PlaceholderText="Meal Name" />

                    <!--  Meal Description  -->
                    <TextBox
                        x:Name="MealDescriptionTextBox"
                        Height="80"
                        AcceptsReturn="True"
                        PlaceholderText="Meal Description"
                        TextWrapping="Wrap" />

                    <!--  Estimated Cost  -->
                    <TextBox
                        x:Name="MealCostTextBox"
                        InputScope="Number"
                        PlaceholderText="Estimated Cost ($)" />

                    <!--  Serving Size  -->
                    <TextBox PlaceholderText="Serving Size (e.g., 200g, 1 bowl)" />

                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Nutrition Info (Per Serving)" />

                    <!--  Calories  -->
                    <TextBox InputScope="Number" PlaceholderText="Calories (kcal)" />

                    <!--  Protein  -->
                    <TextBox InputScope="Number" PlaceholderText="Protein (g)" />

                    <!--  Carbohydrates  -->
                    <TextBox InputScope="Number" PlaceholderText="Carbs (g)" />

                    <!--  Fats  -->
                    <TextBox InputScope="Number" PlaceholderText="Fats (g)" />


                </StackPanel>
            </ScrollViewer>

            <!--  Save Button  -->
            <Button
                Grid.Column="1"
                Margin="0,0,0,20"
                Padding="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="SaveMeal_Click"
                Style="{ThemeResource AccentButtonStyle}">
                <Button.Content>
                    <TextBlock Margin="5,0" Text="Create" />
                </Button.Content>
            </Button>

            <!--  Right Column (Image & Upload Button)  -->
            <StackPanel
                Grid.Column="1"
                Margin="40,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <Border
                    Width="120"
                    Height="120"
                    BorderBrush="AliceBlue"
                    BorderThickness="1"
                    CornerRadius="70">
                    <Image
                        Width="90"
                        Height="90"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="/Assets/MealIcon/plate.png"
                        Stretch="UniformToFill" />
                </Border>
                <Button Content="📷 Upload Image" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
