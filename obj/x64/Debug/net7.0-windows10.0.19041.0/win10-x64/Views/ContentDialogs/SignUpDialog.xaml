<Page
    x:Class="Plateful.Views.ContentDialogs.SignUpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Plateful.Views.ContentDialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>

        <StackPanel
            Width="200"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Spacing="10">

            <!--  Username Input  -->
            <TextBox x:ConnectionId='2'
                Name="UsernameTextBox"
                HorizontalAlignment="Stretch"
                Header="Username"
                PlaceholderText="Enter a username" />

            <!--  Password Input  -->
            <PasswordBox x:ConnectionId='3'
                Name="PasswordTextBox"
                HorizontalAlignment="Stretch"
                Header="Password"
                PlaceholderText="Enter a password" />

            <!--  Confirm Password Input  -->
            <PasswordBox x:ConnectionId='4'
                Name="ConfirmPasswordTextBox"
                HorizontalAlignment="Stretch"
                PlaceholderText="Confirm password" />

            <TextBox x:ConnectionId='5'
                Name="EmailTextBox"
                HorizontalAlignment="Stretch"
                Header="Optional"
                PlaceholderText="Email" />
            <!--  Status Message  -->
            <TextBlock x:ConnectionId='6' Name="SignUpStatusTextBlock" />
        </StackPanel>
    </Grid>
</Page>

